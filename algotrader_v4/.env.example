# ── Zerodha Kite ──────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=          # Generated fresh each trading day

# ── Anthropic (AI Signal Engine) ──────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Telegram Alerts ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Trading Mode ──────────────────────────────────────────────
# PAPER  → simulate orders, no real money
# LIVE   → real Kite orders
TRADING_MODE=PAPER

# ── Risk Controls ─────────────────────────────────────────────
MAX_DAILY_LOSS=5000          # Stop trading if daily loss exceeds this (₹)
MAX_POSITION_SIZE=50000      # Max capital per trade (₹)
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
SQUAREOFF_TIME=15:10         # Auto square-off MIS before 3:15 PM

# ── Backtest Gate ──────────────────────────────────────────────
BT_MIN_WIN_RATE=55               # % — reject if below
BT_MIN_SHARPE=1.0
BT_MAX_DRAWDOWN_PCT=15           # % — reject if above
BT_MIN_TRADES=20
BT_LOOKBACK_DAYS=180

# ── Overtrade Prevention ──────────────────────────────────────
MAX_TRADES_INTRADAY=8
MAX_TRADES_FNO=4
MAX_TRADES_SWING=3
MAX_TRADES_SCALPING=20
COOLDOWN_AFTER_LOSS_SEC=300      # 5 min pause after a losing trade

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173