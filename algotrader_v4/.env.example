# AlgoTrader Pro (core rebuild) — every variable config.py reads. Anything else is ignored.
# Secrets (keys, passwords, tokens) belong in the server environment or the encrypted vault, never in the repo.

# ── Zerodha Kite ──────────────────────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=             # optional: today's token (the daily auto-login refreshes it)
KITE_USER_ID=                  # automatic daily login: client ID, password, TOTP seed (or save them in the vault)
KITE_PASSWORD=
KITE_TOTP_SECRET=
KITE_REDIRECT_URL=https://yourdomain.com/auth/kite/callback
USE_KITE_WEBSOCKET=true

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Security ──────────────────────────────────────────────────────────────────
API_KEY=                       # X-API-Key for every write and every /api/v2 read
KILL_SWITCH_RESET_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=           # bcrypt (deploy/gen-password-hash.py); ADMIN_PASSWORD is a dev-only fallback
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=8

# ── Mode / data ───────────────────────────────────────────────────────────────
TRADING_MODE=PAPER             # the kept strategies refuse LIVE
PAPER_DATA_SOURCE=KITE         # KITE = real quotes, simulated orders; SIM = no data (no entries)
PERSIST_PAPER_BOOK=true
PAPER_BOOK_SAVE_INTERVAL_S=3
SQUAREOFF_TIME=15:15
MARKET_EXTRA_SESSIONS=         # "YYYY-MM-DD:Name,..." full weekend sessions
MARKET_HOLIDAYS=               # "YYYY-MM-DD:Name,..." extra exchange holidays
AUTO_START_WATCHLIST=          # price-feed warm list (default: first 20 NIFTY 50 names)

# ── Order limits (SEBI pre-order check) / paper account ───────────────────────
MAX_POSITION_SIZE=150000
MAX_FUTURES_ORDER_VALUE=2500000
MAX_DAILY_LOSS=5000
MAX_OPEN_POSITIONS=8
TOTAL_CAPITAL=500000

# ── Validated strategies ──────────────────────────────────────────────────────
VALIDATED_ONLY=true
VALIDATED_NOTIONAL_SCALE=1.0
VALIDATED_SPECIAL_SESSIONS=
VALIDATED_AUCTION_ENABLED=true
VALIDATED_AUCTION_VARIANT=2PCT  # code default 3PCT
VALIDATED_AUCTION_MAX_GROSS=1000000
VALIDATED_AUCTION_DAILY_LOSS_STOP=16000
VALIDATED_AUCTION_DD_KILL=37000
VALIDATED_ATTENTION_ENABLED=true
VALIDATED_ATTENTION_MAX_GROSS=1000000
VALIDATED_ATTENTION_DAILY_LOSS_STOP=10000
VALIDATED_ATTENTION_DD_KILL=20000
VALIDATED_STRANGLE_ENABLED=true
VALIDATED_VRP_LOTS=2
VALIDATED_VRP_MAX_MARGIN=250000
VALIDATED_VRP_MAX_LOSS=75000
VALIDATED_VRP_DD_KILL=195000
VALIDATED_PEAD_ENABLED=false    # candidate; off by default
VALIDATED_PEAD_MAX_POSITIONS=100
VALIDATED_PEAD_MAX_GROSS=10000000
VALIDATED_PEAD_DAILY_LOSS_STOP=240000
VALIDATED_PEAD_DD_KILL=1680000
SHADOW_REGISTRY_ENABLED=false
OPTION_BAR_ARCHIVER_ENABLED=false
FORWARD_LAB_ENABLED=false       # forward lab (forward_lab.py): every lab strategy after the close, no orders
FORWARD_LAB_MAX_MB=300          # disk cap of <ledger dir>/forward_lab (stop writing, never delete)
FORWARD_LAB_JOBS=1
FORWARD_LAB_TIME_LIMIT_S=2700
FORWARD_LAB_MEM_MB=3072
FORWARD_LAB_TELEGRAM=false

# ── Engine (REBUILD.md) ───────────────────────────────────────────────────────
RISK_BUDGET_DAILY_VOL=0         # 0 = lab sizing (scale 1.0)
RISK_BUDGET_ALLOW_UPSCALE=false
RISK_BUDGET_MAX_SCALE=1.0
RISK_CAPITAL=2500000
RISK_BRAKE_REDUCE_PCT=16
RISK_BRAKE_HALT_PCT=24
APPROVAL_MODE=false
DRIFT_TELEGRAM=false
ORDER_PROTECTION_BAND_PCT=0.5
KITE_STATIC_IP=                 # LIVE prerequisite (Kite static-IP rule, 1 Apr 2026)

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
