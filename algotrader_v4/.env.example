# ── Zerodha Kite ──────────────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Kite auto-login (Playwright — enables fully automated morning refresh)
KITE_USER_ID=              # your Zerodha client ID e.g. ZA1234
KITE_PASSWORD=             # your Zerodha login password
KITE_TOTP_SECRET=          # TOTP seed from Zerodha 2FA setup (shown when enabling authenticator)
KITE_REDIRECT_URL=https://yourdomain.com/auth/kite/callback

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram alerts ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── App API key (X-API-Key header for programmatic access) ────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
KILL_SWITCH_RESET_SECRET=

# ── App login (JWT) ───────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate hash: python3 algotrader_v4/deploy/gen-password-hash.py
ADMIN_PASSWORD_HASH=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=8

# ── Auto-start (fully lights-out operation) ───────────────────────
# Comma-separated strategies to start automatically at 09:16 IST
# e.g. AUTO_START_STRATEGIES=intraday,scalping
AUTO_START_STRATEGIES=
# Comma-separated symbols (leave empty to use symbol scanner output)
AUTO_START_WATCHLIST=

# ── Trading mode ─────────────────────────────────────────────────
# PAPER = simulate | LIVE = real orders
TRADING_MODE=PAPER

# ── Risk limits ───────────────────────────────────────────────────
MAX_DAILY_LOSS=5000.0
MAX_POSITION_SIZE=50000.0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
SQUAREOFF_TIME=15:10

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://yourdomain.com
