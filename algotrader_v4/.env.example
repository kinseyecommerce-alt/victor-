# ── Zerodha Kite ──────────────────────────────────────────────────
KITE_API_KEY=

# Keys saved in the dashboard (Settings → API Keys) are stored encrypted in .secrets/ and override
# the values above. Optional: keep the encryption key out of .secrets/ by setting it here or, better,
# in the server's environment. Generate one with:  python3 secret_store.py --new-key
# SECRETS_MASTER_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Kite auto-login (Playwright — enables fully automated morning refresh)
KITE_USER_ID=              # your Zerodha client ID e.g. ZA1234
KITE_PASSWORD=             # your Zerodha login password
KITE_TOTP_SECRET=          # TOTP seed from Zerodha 2FA setup (shown when enabling authenticator)
KITE_REDIRECT_URL=https://yourdomain.com/auth/kite/callback

# ── TrueData (optional — richer tick feed + options chain) ────────
# Requires: pip install truedata-ws
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
# Enable each feature independently (credentials required):
USE_TRUEDATA_WEBSOCKET=false   # primary live tick source (replaces Kite WS)
USE_TRUEDATA_HISTORICAL=false  # OHLCV history for backtesting / warm-up
USE_TRUEDATA_OPTIONS=false     # options chain for IV rank, PCR, max pain

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Autonomous AI trader (Claude) ──────────────────────────────────
# Trades NSE equities intraday through the same risk/SEBI checks as the agents.
# Hard limits are enforced in code. Needs ANTHROPIC_API_KEY.
AI_AGENT_MODEL=claude-opus-5-5
AI_AGENT_EFFORT=medium            # low | medium | high | xhigh | max
AI_AGENT_INTERVAL_MIN=15         # full review every N min (0 = off); real-time alerts run regardless
AI_AGENT_REALTIME=true            # code watches every tick; Claude is called the moment a setup fires
AI_AGENT_REALTIME_EFFORT=low      # faster, cheaper decisions on alerts
AI_AGENT_TRIGGER_COOLDOWN_S=180
AI_AGENT_MIN_CALL_GAP_S=3
AI_AGENT_EVENT_MAX_AGE_S=20
AI_AGENT_MAX_DRIFT_PCT=0.3
AI_AGENT_BURST_PCT=0.5
# AI-managed trailing stops (stops only tighten; mechanical trail is the fallback)
AI_AGENT_AI_TRAILING=true
AI_AGENT_TRAIL_REVIEW_S=120
AI_AGENT_TRAIL_MIN_GAP_PCT=0.15
AI_AGENT_OPTION_TRAIL_MIN_GAP_PCT=5
# AI option buying (index CE/PE only; never sells options). Contracts come from Kite's
# instrument list; needs a Kite session for real-price paper or LIVE.
AI_AGENT_OPTIONS_ENABLED=true
AI_AGENT_OPTION_UNDERLYINGS=NIFTY,BANKNIFTY
AI_AGENT_MAX_OPTION_PREMIUM=15000
AI_AGENT_MAX_OPTION_LOTS=2
AI_AGENT_OPTION_MIN_SL_PCT=15
AI_AGENT_OPTION_MAX_SL_PCT=40
AI_AGENT_OPTION_MAX_SPREAD_PCT=3
AI_AGENT_OPTION_MIN_PREMIUM=10
AI_AGENT_OPTION_MAX_IV_RANK=72

# AI swing trades — NSE delivery (CNC), long only, held for days. The stop is a GTT at
# Zerodha (works overnight); positions are saved to data/ai_swing_positions.json.
AI_AGENT_SWING_ENABLED=true
AI_AGENT_MAX_SWING_POSITIONS=2
AI_AGENT_MAX_SWING_VALUE=50000
AI_AGENT_SWING_MIN_SL_PCT=1.5
AI_AGENT_SWING_MAX_SL_PCT=8.0
AI_AGENT_SWING_MIN_RR=2.0
AI_AGENT_SWING_MAX_HOLD_DAYS=15
AI_AGENT_SWING_SCAN_TIME=14:50
# Bearish swing = buy a put (stock or index), NRML, held for days, GTT stop; loss ≤ premium
AI_AGENT_SWING_PUTS_ENABLED=true
AI_AGENT_MAX_SWING_PUT_PREMIUM=15000
AI_AGENT_SWING_PUT_MIN_SL_PCT=25
AI_AGENT_SWING_PUT_MAX_SL_PCT=50
AI_AGENT_SWING_PUT_EXPIRY_BUFFER_DAYS=7

# AI index futures — intraday only, long or short. LEVERAGED: off until you turn it on.
AI_AGENT_FUTURES_ENABLED=false
AI_AGENT_FUTURE_UNDERLYINGS=NIFTY,BANKNIFTY
AI_AGENT_MAX_FUTURE_LOTS=1
AI_AGENT_MAX_FUTURE_RISK=5000        # ₹ lost if the stop is hit
AI_AGENT_MAX_FUTURE_MARGIN=300000    # ₹ margin blocked per trade
AI_AGENT_FUTURE_MIN_SL_PCT=0.15
AI_AGENT_FUTURE_MAX_SL_PCT=1.0
MAX_FUTURES_ORDER_VALUE=2500000      # contract value cap per futures order (1 NIFTY lot ≈ ₹18 lakh)

# AI option SELLING — credit spreads only (sell 1, buy 1 further OTM as protection), intraday.
# Worst case is fixed at entry. Naked option selling is never allowed. Off until you turn it on.
AI_AGENT_OPTION_SELLING_ENABLED=false
AI_AGENT_MAX_SPREAD_LOTS=1
AI_AGENT_MAX_SPREAD_LOSS=10000       # ₹ worst case: (strike width − credit) × quantity
AI_AGENT_MAX_SPREAD_MARGIN=150000
AI_AGENT_SPREAD_MIN_CREDIT_PCT=20    # credit ≥ this % of the strike width
AI_AGENT_ALLOW_LIVE=false         # keep false until it has proven itself in PAPER
AI_AGENT_MAX_TRADES_PER_DAY=5
AI_AGENT_MAX_OPEN_POSITIONS=2
AI_AGENT_MAX_POSITION_VALUE=50000
AI_AGENT_MAX_SL_PCT=2.0
AI_AGENT_MIN_SL_PCT=0.2
AI_AGENT_MAX_STEPS=12
AI_AGENT_MAX_DAILY_COST_USD=20

# ── Telegram alerts ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── n8n integration ────────────────────────────────────────────────
# Outbound: AlgoTrader POSTs all events (trade_entry/exit, signal,
#           regime_change, system) to this URL
# Get URL from: n8n Webhook node → copy "Test URL" or "Production URL"
N8N_WEBHOOK_URL=
# Optional HMAC-SHA256 signing secret — set same value in n8n workflow
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=

# ── App API key (X-API-Key header for programmatic access) ────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
KILL_SWITCH_RESET_SECRET=

# ── App login (JWT) ───────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate hash: python3 algotrader_v4/deploy/gen-password-hash.py
ADMIN_PASSWORD_HASH=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=8

# ── Pre-learned system (run historical_learner.py first, then set these) ──
SKIP_STARTUP_BACKTEST=false    # true = use pre-learned approved_symbols.json
USE_NIFTY100_WATCHLIST=false   # true = auto-use full Nifty 100 as watchlist

# ── Intelligence layer ────────────────────────────────────────────
USE_CLAUDE_TRADE_GATE=true     # Claude (Sonnet) vets every trade signal
CLAUDE_GATE_THRESHOLD=65       # min confidence score to enter (master adjusts dynamically)
USE_MULTI_TIMEFRAME=true       # require 5m + 15m TF alignment before entry
MTF_MIN_ALIGNMENT=2            # TFs that must agree: 1, 2, or 3
USE_KELLY_SIZING=true          # scale position size by Claude's size_factor

# ── Auto-start (fully lights-out operation) ───────────────────────
# Comma-separated strategies to start automatically at 09:16 IST
# e.g. AUTO_START_STRATEGIES=intraday,scalping
AUTO_START_STRATEGIES=
# Comma-separated symbols (leave empty to use symbol scanner output)
AUTO_START_WATCHLIST=

# ── Trading mode ─────────────────────────────────────────────────
# PAPER = simulate | LIVE = real orders
TRADING_MODE=PAPER
# Price feed in PAPER mode: SIM = random simulator | KITE = real Kite quotes
# (KITE needs KITE_API_KEY + a valid access token; orders are still simulated)
PAPER_DATA_SOURCE=SIM
# Demo (PAPER + SIM only): clock starts at 10:00 IST so the market is "open" whenever you
# test, and the simulator trends so strategies fire. Easiest: ./run_demo.sh
DEMO_MODE=false

# ── Risk limits ───────────────────────────────────────────────────
MAX_DAILY_LOSS=5000.0
MAX_POSITION_SIZE=50000.0
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=1.5
TARGET_PCT=3.0
SQUAREOFF_TIME=15:10

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://yourdomain.com
